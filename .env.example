# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

# Flask session signing key. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# SQLite database file path (relative to project root or absolute).
# Swap for a PostgreSQL connection string in production (NFR not required
# for the prototype, but the repository layer is the only place that would
# need to change).
DATABASE_PATH=instance/app.db

# Which SentimentAnalyzer strategy to use (Strategy + Factory pattern,
# app/nlp/analyzer.py). Currently only "vader" is implemented.
SENTIMENT_ANALYZER=vader

# Alert thresholds (FR-14)
NEGATIVE_PCT_ALERT_THRESHOLD=40
AVG_RATING_ALERT_THRESHOLD=2.5
MIN_RESPONSES_FOR_ALERT=3

FLASK_APP=run.py
FLASK_DEBUG=1
